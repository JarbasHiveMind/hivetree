# Fixed credentials so upstream links are pre-wired deterministically.
# access_key is a semi-public identifier; password is the secret. These are a
# throwaway test rig on an isolated docker network — not production secrets.

# relay upstream links (relay's client credentials ON the root M0)
R1_UP_KEY=r1-upstream-key
R1_UP_PWD=r1-upstream-pw-9f3a1c7e2b8d4055
R2_UP_KEY=r2-upstream-key
R2_UP_PWD=r2-upstream-pw-7b1e2d9c4a6f8033

# direct probe client on the root
M0DIR_KEY=m0-direct-key
M0DIR_PWD=m0-direct-pw-1a4c21357368b0aa

# leaf test clients under R1
SAT1A_KEY=sat-1a-key
SAT1A_PWD=sat-1a-pw-2931ca92abfcaf59
SAT1B_KEY=sat-1b-key
SAT1B_PWD=sat-1b-pw-611fb990da3dd063

# leaf test clients under R2
SAT2A_KEY=sat-2a-key
SAT2A_PWD=sat-2a-pw-30a850b45e3f582a
SAT2B_KEY=sat-2b-key
SAT2B_PWD=sat-2b-pw-5e9bfcc9c529b6e3
